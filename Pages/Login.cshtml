@page
@model AnasAI.Pages.LoginModel

@{
    Layout = null;
    ViewData["Title"] = "User Login — Anas AI";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>User Login — Anas AI</title>

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            min-height: 100%;
        }

        body {
            min-height: 100vh;

            display: flex;
            align-items: center;
            justify-content: center;

            padding: 20px;

            font-family:
                Inter,
                system-ui,
                -apple-system,
                "Segoe UI",
                sans-serif;

            background:
                radial-gradient(
                    circle at 20% 10%,
                    rgba(16,163,127,.18),
                    transparent 35%
                ),
                radial-gradient(
                    circle at 85% 80%,
                    rgba(59,130,246,.12),
                    transparent 35%
                ),
                #080b12;

            color: white;
        }

        .card {
            width: min(430px, 100%);

            padding: 36px;

            border-radius: 26px;

            background:
                linear-gradient(
                    145deg,
                    rgba(25,31,44,.96),
                    rgba(12,16,25,.96)
                );

            border: 1px solid rgba(255,255,255,.10);

            box-shadow:
                0 35px 100px rgba(0,0,0,.55);

            backdrop-filter: blur(25px);
        }

        .brand {
            text-align: center;
            margin-bottom: 25px;
        }

        .logo {
            width: 64px;
            height: 64px;

            margin: 0 auto 17px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 19px;

            background:
                linear-gradient(
                    135deg,
                    #10a37f,
                    #087f63
                );

            font-size: 27px;
            font-weight: 800;

            box-shadow:
                0 12px 35px rgba(16,163,127,.28);
        }

        h1 {
            margin: 0;
            font-size: 26px;
        }

        .subtitle {
            margin-top: 8px;
            color: #8f9aaa;
            font-size: 13px;
        }

        .badge {
            width: fit-content;

            margin: 0 auto 25px;

            padding: 7px 12px;

            border-radius: 999px;

            background: rgba(16,163,127,.08);

            border: 1px solid rgba(16,163,127,.16);

            color: #7dd3bd;

            font-size: 11px;
        }

        .group {
            margin-bottom: 17px;
        }

        label {
            display: block;

            margin-bottom: 8px;

            color: #d6dbe4;

            font-size: 12px;
            font-weight: 600;
        }

        input {
            width: 100%;
            height: 48px;

            padding: 0 14px;

            border:
                1px solid #303746;

            border-radius: 13px;

            outline: none;

            background:
                rgba(8,11,18,.72);

            color: white;

            font-size: 13px;
        }

        input:focus {
            border-color: #10a37f;

            box-shadow:
                0 0 0 3px
                rgba(16,163,127,.11);
        }

        input::placeholder {
            color: #596274;
        }

        .error {
            margin-bottom: 17px;

            padding: 11px 13px;

            border-radius: 12px;

            background:
                rgba(239,68,68,.09);

            border:
                1px solid rgba(239,68,68,.18);

            color: #fca5a5;

            font-size: 12px;
        }

        button {
            width: 100%;
            height: 49px;

            margin-top: 5px;

            border: none;
            border-radius: 13px;

            background:
                linear-gradient(
                    135deg,
                    #10a37f,
                    #0b8f70
                );

            color: white;

            font-size: 13px;
            font-weight: 700;

            cursor: pointer;
        }

        button:hover {
            opacity: .92;
        }

        .footer {
            margin-top: 23px;

            text-align: center;

            color: #687386;

            font-size: 10px;
        }

    </style>

</head>

<body>

    <main class="card">

        <div class="brand">

            <div class="logo">
                A
            </div>

            <h1>
                Anas AI
            </h1>

            <div class="subtitle">
                Sign in to your account
            </div>

        </div>

        <div class="badge">
            🔐 Secure User Access
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="error">
                ⚠️ @Model.ErrorMessage
            </div>
        }

        <form method="post">

            <div class="group">

                <label for="Username">
                    Username
                </label>

                <input asp-for="Username"
                       id="Username"
                       autocomplete="username"
                       placeholder="Enter your username"
                       required />

            </div>

            <div class="group">

                <label for="Password">
                    Password
                </label>

                <input asp-for="Password"
                       id="Password"
                       type="password"
                       autocomplete="current-password"
                       placeholder="Enter your password"
                       required />

            </div>

            <div class="group">

                <label for="LicenseKey">
                    License Key
                </label>

                <input asp-for="LicenseKey"
                       id="LicenseKey"
                       autocomplete="off"
                       placeholder="Enter your license key"
                       required />

            </div>

            <button type="submit">
                Sign In to Anas AI
            </button>

        </form>

        <div class="footer">
            🛡️ Licensed access • ANAS AI
        </div>

    </main>

</body>

</html>