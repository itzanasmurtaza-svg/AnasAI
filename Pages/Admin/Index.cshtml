@page
@model AnasAI.Pages.Admin.IndexModel

@{
    Layout = null;
    ViewData["Title"] = "Anas AI Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Anas AI Admin Dashboard</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Inter, system-ui, sans-serif;
            background: #080b12;
            color: white;
        }

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 240px;
            height: 100vh;
            padding: 25px 18px;
            background: #0d111b;
            border-right: 1px solid rgba(255,255,255,.08);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 35px;
            font-size: 20px;
            font-weight: 800;
        }

        .logo-box {
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: linear-gradient(135deg,#10a37f,#087f63);
        }

        .nav {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .nav a {
            padding: 12px 14px;
            border-radius: 10px;
            color: #9ca3af;
            text-decoration: none;
            font-size: 13px;
        }

        .nav a:hover,
        .nav a.active {
            background: rgba(16,163,127,.12);
            color: #10a37f;
        }

        .main {
            margin-left: 240px;
            padding: 35px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        h1 {
            margin: 0;
            font-size: 28px;
        }

        .subtitle {
            margin-top: 7px;
            color: #7d8798;
            font-size: 13px;
        }

        .status {
            padding: 9px 14px;
            border-radius: 999px;
            background: rgba(16,163,127,.1);
            border: 1px solid rgba(16,163,127,.2);
            color: #6ee7c5;
            font-size: 12px;
        }

        .cards {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .card {
            padding: 22px;
            border-radius: 18px;
            background: #111722;
            border: 1px solid rgba(255,255,255,.08);
        }

        .card-title {
            color: #8b95a7;
            font-size: 12px;
            margin-bottom: 12px;
        }

        .card-value {
            font-size: 28px;
            font-weight: 800;
        }

        .quick {
            margin-top: 25px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 18px;
        }

        .action {
            display: block;
            padding: 24px;
            border-radius: 18px;
            background: #111722;
            border: 1px solid rgba(255,255,255,.08);
            color: white;
            text-decoration: none;
        }

        .action:hover {
            border-color: rgba(16,163,127,.4);
            transform: translateY(-2px);
        }

        .action h3 {
            margin: 0 0 8px;
        }

        .action p {
            margin: 0;
            color: #7d8798;
            font-size: 12px;
        }

        @@media(max-width:800px) {
            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .main {
                margin-left: 0;
                padding: 20px;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .quick {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

    <aside class="sidebar">

        <div class="logo">
            <div class="logo-box">A</div>
            <span>Anas AI</span>
        </div>

        <nav class="nav">

            <a class="active" href="/Admin/Index">
                Dashboard
            </a>

            <a href="/Admin/Users">
                Users
            </a>

            <a href="/Admin/Licenses">
                Licenses
            </a>

            <a href="/Admin/Login">
                Logout
            </a>

        </nav>

    </aside>

    <main class="main">

        <div class="header">

            <div>
                <h1>Admin Dashboard</h1>

                <div class="subtitle">
                    Manage your Anas AI system
                </div>
            </div>

            <div class="status">
                ● System Online
            </div>

        </div>

        <section class="cards">

            <div class="card">
                <div class="card-title">
                    SYSTEM
                </div>

                <div class="card-value">
                    Online
                </div>
            </div>

            <div class="card">
                <div class="card-title">
                    DATABASE
                </div>

                <div class="card-value">
                    SQLite
                </div>
            </div>

            <div class="card">
                <div class="card-title">
                    AI
                </div>

                <div class="card-value">
                    Active
                </div>
            </div>

        </section>

        <section class="quick">

            <a class="action" href="/Admin/Users">

                <h3>👤 Manage Users</h3>

                <p>
                    Create and manage Anas AI users and accounts.
                </p>

            </a>

            <a class="action" href="/Admin/Licenses">

                <h3>🔑 Manage Licenses</h3>

                <p>
                    Create licenses and control AI features.
                </p>

            </a>

        </section>

    </main>

</body>
</html>