@page
@model AnasAI.Pages.Admin.BackupModel

@{
    Layout = null;
    ViewData["Title"] = "Database Backup — Anas AI";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Database Backup — Anas AI</title>

    <style>

        * {
            box-sizing: border-box;
        }

        :root {
            --bg: #070a11;
            --sidebar: #0c1019;
            --panel: #101722;
            --panel2: #121b29;
            --border: rgba(255,255,255,.08);
            --text: #f8fafc;
            --muted: #8490a3;
            --green: #10b981;
            --green2: #087f63;
            --blue: #6366f1;
            --red: #ef4444;
            --yellow: #f59e0b;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            font-family:
                Inter,
                system-ui,
                -apple-system,
                "Segoe UI",
                sans-serif;

            background:
                radial-gradient(
                    circle at 70% 0%,
                    rgba(16,185,129,.08),
                    transparent 28%
                ),
                var(--bg);

            color: var(--text);
        }

        button,
        select {
            font: inherit;
        }

        button {
            cursor: pointer;
        }


        /* SIDEBAR */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            height: 100vh;
            padding: 24px 18px;

            background: rgba(12,16,25,.97);

            border-right:
                1px solid var(--border);

            z-index: 20;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;

            padding: 4px 8px;
            margin-bottom: 38px;

            font-size: 20px;
            font-weight: 800;
        }

        .logo-box {
            width: 43px;
            height: 43px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 13px;

            background:
                linear-gradient(
                    135deg,
                    #10b981,
                    #087f63
                );

            box-shadow:
                0 10px 30px
                rgba(16,185,129,.2);
        }

        .nav {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .nav a {
            display: flex;
            align-items: center;
            gap: 11px;

            padding: 12px 14px;

            border-radius: 11px;

            color: #9aa5b7;

            text-decoration: none;

            font-size: 13px;

            transition: .2s ease;
        }

        .nav a:hover {
            color: white;
            background: rgba(255,255,255,.045);
        }

        .nav a.active {
            color: #5ee7c3;

            background:
                linear-gradient(
                    90deg,
                    rgba(16,185,129,.15),
                    rgba(16,185,129,.05)
                );

            border:
                1px solid
                rgba(16,185,129,.10);
        }

        .sidebar-footer {
            position: absolute;

            left: 18px;
            right: 18px;
            bottom: 20px;

            padding: 13px;

            border-radius: 13px;

            background:
                rgba(255,255,255,.035);

            border:
                1px solid var(--border);
        }

        .sidebar-footer small {
            display: block;

            color: #657083;

            font-size: 10px;

            margin-bottom: 4px;
        }

        .sidebar-footer strong {
            font-size: 12px;
        }


        /* MAIN */

        .main {
            margin-left: 250px;

            padding: 34px;

            min-height: 100vh;
        }

        .header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;

            gap: 20px;

            margin-bottom: 28px;
        }

        .eyebrow {
            color: #5ee7c3;

            font-size: 11px;

            font-weight: 700;

            letter-spacing: .12em;

            text-transform: uppercase;

            margin-bottom: 8px;
        }

        h1 {
            margin: 0;

            font-size: 31px;

            letter-spacing: -.03em;
        }

        .subtitle {
            margin-top: 7px;

            color: var(--muted);

            font-size: 13px;
        }


        /* STATUS */

        .connection {
            display: flex;
            align-items: center;
            gap: 9px;

            padding: 10px 14px;

            border-radius: 999px;

            background:
                rgba(16,185,129,.08);

            border:
                1px solid
                rgba(16,185,129,.15);

            color: #6ee7c5;

            font-size: 11px;

            font-weight: 700;
        }

        .dot {
            width: 7px;
            height: 7px;

            border-radius: 50%;

            background: var(--green);

            box-shadow:
                0 0 12px
                rgba(16,185,129,.8);
        }


        /* STATS */

        .stats {
            display: grid;

            grid-template-columns:
                repeat(3,minmax(0,1fr));

            gap: 15px;

            margin-bottom: 20px;
        }

        .stat {
            padding: 20px;

            border-radius: 16px;

            background:
                linear-gradient(
                    145deg,
                    rgba(18,27,41,.94),
                    rgba(13,19,29,.94)
                );

            border:
                1px solid var(--border);
        }

        .stat-icon {
            width: 36px;
            height: 36px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 10px;

            background:
                rgba(16,185,129,.08);

            margin-bottom: 14px;
        }

        .stat-label {
            color: #788497;

            font-size: 10px;

            font-weight: 700;

            text-transform: uppercase;

            letter-spacing: .08em;
        }

        .stat-value {
            margin-top: 8px;

            font-size: 24px;

            font-weight: 800;
        }

        .stat-value.green {
            color: #5ee7c3;
        }


        /* BACKUP CONTROL */

        .grid {
            display: grid;

            grid-template-columns:
                minmax(0,1.35fr)
                minmax(300px,.65fr);

            gap: 18px;
        }

        .card {
            padding: 23px;

            border-radius: 18px;

            background:
                linear-gradient(
                    145deg,
                    rgba(16,23,34,.96),
                    rgba(11,16,25,.96)
                );

            border:
                1px solid var(--border);

            box-shadow:
                0 20px 70px
                rgba(0,0,0,.15);
        }

        .card-head {
            display: flex;

            align-items: flex-start;

            justify-content: space-between;

            gap: 15px;

            margin-bottom: 20px;
        }

        .card-head h2 {
            margin: 0;

            font-size: 16px;
        }

        .card-head p {
            margin: 5px 0 0;

            color: var(--muted);

            font-size: 11px;
        }


        /* BIG BACKUP BUTTON */

        .backup-button {
            width: 100%;

            min-height: 115px;

            display: flex;

            flex-direction: column;

            align-items: center;

            justify-content: center;

            gap: 8px;

            border: 1px solid
                rgba(16,185,129,.20);

            border-radius: 16px;

            background:
                linear-gradient(
                    145deg,
                    rgba(16,185,129,.13),
                    rgba(16,185,129,.035)
                );

            color: white;

            transition: .2s ease;
        }

        .backup-button:hover {
            transform: translateY(-2px);

            border-color:
                rgba(16,185,129,.42);

            box-shadow:
                0 15px 40px
                rgba(16,185,129,.10);
        }

        .backup-icon {
            font-size: 28px;
        }

        .backup-button strong {
            font-size: 14px;
        }

        .backup-button span {
            color: #8290a3;

            font-size: 10px;
        }


        /* AUTOMATIC BACKUP */

        .setting {
            display: flex;

            align-items: center;

            justify-content: space-between;

            padding: 15px 0;

            border-bottom:
                1px solid
                rgba(255,255,255,.05);
        }

        .setting:last-child {
            border-bottom: 0;
        }

        .setting-title {
            font-size: 12px;

            font-weight: 700;
        }

        .setting-desc {
            margin-top: 4px;

            color: #69768a;

            font-size: 10px;
        }

        select {
            height: 38px;

            padding: 0 10px;

            border-radius: 9px;

            border:
                1px solid var(--border);

            background: #080c13;

            color: white;

            outline: none;
        }


        /* TOGGLE */

        .switch {
            position: relative;

            width: 43px;
            height: 24px;
        }

        .switch input {
            opacity: 0;

            width: 0;
            height: 0;
        }

        .slider {
            position: absolute;

            inset: 0;

            border-radius: 30px;

            background: #293241;

            transition: .2s;
        }

        .slider:before {
            content: "";

            position: absolute;

            width: 18px;
            height: 18px;

            left: 3px;
            top: 3px;

            border-radius: 50%;

            background: white;

            transition: .2s;
        }

        .switch input:checked + .slider {
            background: var(--green);
        }

        .switch input:checked + .slider:before {
            transform: translateX(19px);
        }


        /* DRIVE */

        .drive-box {
            padding: 18px;

            border-radius: 14px;

            background:
                rgba(255,255,255,.025);

            border:
                1px solid var(--border);
        }

        .drive-top {
            display: flex;

            align-items: center;

            gap: 12px;

            margin-bottom: 14px;
        }

        .drive-icon {
            width: 40px;
            height: 40px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 11px;

            background:
                rgba(99,102,241,.12);
        }

        .drive-name {
            font-size: 13px;

            font-weight: 750;
        }

        .drive-status {
            margin-top: 3px;

            color: #6ee7c5;

            font-size: 10px;
        }

        .drive-connect {
            width: 100%;

            padding: 10px;

            border-radius: 9px;

            border: 1px solid var(--border);

            background:
                rgba(255,255,255,.04);

            color: #d3dae4;

            font-size: 11px;

            font-weight: 700;
        }


        /* HISTORY */

        .history {
            margin-top: 18px;
        }

        .history-item {
            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 15px;

            padding: 14px 0;

            border-bottom:
                1px solid
                rgba(255,255,255,.05);
        }

        .history-item:last-child {
            border-bottom: 0;
        }

        .history-name {
            font-family: Consolas, monospace;

            font-size: 11px;

            color: #b8c2d1;
        }

        .history-time {
            margin-top: 4px;

            color: #69768a;

            font-size: 9px;
        }

        .success-badge {
            padding: 5px 8px;

            border-radius: 999px;

            background:
                rgba(16,185,129,.08);

            border:
                1px solid
                rgba(16,185,129,.12);

            color: #6ee7c5;

            font-size: 9px;

            font-weight: 700;
        }


        /* RESPONSIVE */

        @@media(max-width:1000px) {

            .sidebar {
                position: relative;

                width: 100%;
                height: auto;
            }

            .sidebar-footer {
                display: none;
            }

            .main {
                margin-left: 0;
            }

            .grid {
                grid-template-columns: 1fr;
            }

        }

        @@media(max-width:700px) {

            .main {
                padding: 18px;
            }

            .header {
                flex-direction: column;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .connection {
                width: 100%;
                justify-content: center;
            }

        }

    </style>

</head>


<body>


    <!-- SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">

            <div class="logo-box">
                A
            </div>

            <span>
                Anas AI
            </span>

        </div>


        <nav class="nav">

            <a href="/Admin/Index">
                📊 Dashboard
            </a>

            <a href="/Admin/Users">
                👤 Users
            </a>

            <a href="/Admin/Licenses">
                🔑 Licenses
            </a>

            <a class="active"
               href="/Admin/Backup">
                ☁️ Backup
            </a>

            <a href="/Admin/Login">
                🚪 Logout
            </a>

        </nav>


        <div class="sidebar-footer">

            <small>
                ADMIN CONSOLE
            </small>

            <strong>
                Anas AI Management
            </strong>

        </div>

    </aside>



    <!-- MAIN -->

    <main class="main">


        <div class="header">

            <div>

                <div class="eyebrow">
                    Security & Storage
                </div>

                <h1>
                    Database Backup
                </h1>

                <div class="subtitle">
                    Protect your Anas AI users, licenses and application data.
                </div>

            </div>


            <div class="connection">

                <span class="dot"></span>

                Database Connected

            </div>

        </div>



        <!-- STATS -->

        <section class="stats">

            <div class="stat">

                <div class="stat-icon">
                    💾
                </div>

                <div class="stat-label">
                    Database
                </div>

                <div class="stat-value">
                    @Model.DatabaseSize
                </div>

            </div>


            <div class="stat">

                <div class="stat-icon">
                    🕐
                </div>

                <div class="stat-label">
                    Last Backup
                </div>

                <div class="stat-value"
                     style="font-size:18px">

                    @(Model.LastBackup ?? "Never")

                </div>

            </div>


            <div class="stat">

                <div class="stat-icon">
                    ☁️
                </div>

                <div class="stat-label">
                    Cloud Storage
                </div>

                <div class="stat-value green"
                     style="font-size:18px">

                    Google Drive

                </div>

            </div>

        </section>



        <section class="grid">


            <!-- BACKUP CONTROL -->

            <div class="card">

                <div class="card-head">

                    <div>

                        <h2>
                            Backup Controls
                        </h2>

                        <p>
                            Create a secure copy of your database.
                        </p>

                    </div>

                </div>


                <form
                    method="post"
                    asp-page-handler="CreateBackup">

                    <button
                        class="backup-button"
                        type="submit">

                        <div class="backup-icon">
                            💾
                        </div>

                        <strong>
                            Create Backup Now
                        </strong>

                        <span>
                            Generate a complete SQLite database backup
                        </span>

                    </button>

                </form>


                <div class="setting">

                    <div>

                        <div class="setting-title">
                            Automatic Backup
                        </div>

                        <div class="setting-desc">
                            Automatically create backups.
                        </div>

                    </div>


                    <label class="switch">

                        <input
                            type="checkbox"
                            checked />

                        <span class="slider"></span>

                    </label>

                </div>


                <div class="setting">

                    <div>

                        <div class="setting-title">
                            Backup Frequency
                        </div>

                        <div class="setting-desc">
                            How often automatic backups should run.
                        </div>

                    </div>


                    <select>

                        <option>
                            Every 24 Hours
                        </option>

                        <option>
                            Every 12 Hours
                        </option>

                        <option>
                            Every 6 Hours
                        </option>

                        <option>
                            Every Week
                        </option>

                    </select>

                </div>

            </div>



            <!-- CLOUD -->

            <div class="card">

                <div class="card-head">

                    <div>

                        <h2>
                            Cloud Storage
                        </h2>

                        <p>
                            Secure off-site database protection.
                        </p>

                    </div>

                </div>


                <div class="drive-box">

                    <div class="drive-top">

                        <div class="drive-icon">
                            ☁️
                        </div>

                        <div>

                            <div class="drive-name">
                                Google Drive
                            </div>

                            <div class="drive-status">
                                Not Connected
                            </div>

                        </div>

                    </div>


                    <button
                        type="button"
                        class="drive-connect"
                        onclick="showDriveMessage()">

                        Connect Google Drive

                    </button>

                </div>

            </div>

        </section>



        <!-- HISTORY -->

        <div class="card history">

            <div class="card-head">

                <div>

                    <h2>
                        Backup History
                    </h2>

                    <p>
                        Recent database backup activity.
                    </p>

                </div>

            </div>


            @if (Model.Backups.Count == 0)
            {
                <div style="
                    padding:30px 0;
                    color:#69768a;
                    font-size:12px;">

                    No backups created yet.

                </div>
            }
            else
            {

                foreach (var backup in Model.Backups)
                {

                    <div class="history-item">

                        <div>

                            <div class="history-name">
                                @backup.FileName
                            </div>

                            <div class="history-time">
                                @backup.CreatedAt.ToLocalTime()
                            </div>

                        </div>


                        <span class="success-badge">
                            ✓ Created
                        </span>

                    </div>

                }

            }

        </div>


    </main>



    <script>

        function showDriveMessage() {

            alert(
                "Google Drive connection will be configured in the next step."
            );

        }

    </script>

</body>

</html>