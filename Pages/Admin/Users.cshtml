@page
@model AnasAI.Pages.Admin.UsersModel

@{
    Layout = null;
    ViewData["Title"] = "Manage Users";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Users — Anas AI Admin</title>

    <style>

        * {
            box-sizing: border-box;
        }

        :root {
            --bg: #070a11;
            --sidebar: #0c1019;
            --panel: #101722;
            --panel2: #121b29;
            --border: rgba(255,255,255,.08);
            --text: #f8fafc;
            --muted: #8490a3;
            --green: #10b981;
            --green2: #0b8f70;
            --red: #ef4444;
            --blue: #6366f1;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
        }

        body {
            min-height: 100vh;
            font-family:
                Inter,
                system-ui,
                -apple-system,
                "Segoe UI",
                sans-serif;
            background:
                radial-gradient(
                    circle at 70% 0%,
                    rgba(16,185,129,.08),
                    transparent 28%
                ),
                var(--bg);
            color: var(--text);
        }

        button,
        input,
        select {
            font: inherit;
        }

        button {
            cursor: pointer;
        }


        /* =========================
           SIDEBAR
        ========================= */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 250px;
            height: 100vh;
            padding: 24px 18px;
            background: rgba(12,16,25,.96);
            border-right: 1px solid var(--border);
            z-index: 20;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 4px 8px;
            margin-bottom: 38px;
            font-size: 20px;
            font-weight: 800;
        }

        .logo-box {
            width: 43px;
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            background:
                linear-gradient(
                    135deg,
                    #10b981,
                    #087f63
                );
            box-shadow:
                0 10px 30px rgba(16,185,129,.2);
        }

        .nav {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .nav a {
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 12px 14px;
            border-radius: 11px;
            color: #9aa5b7;
            text-decoration: none;
            font-size: 13px;
            transition: .2s ease;
        }

        .nav a:hover {
            color: white;
            background: rgba(255,255,255,.045);
        }

        .nav a.active {
            color: #5ee7c3;
            background:
                linear-gradient(
                    90deg,
                    rgba(16,185,129,.15),
                    rgba(16,185,129,.05)
                );
            border: 1px solid rgba(16,185,129,.10);
        }

        .sidebar-footer {
            position: absolute;
            left: 18px;
            right: 18px;
            bottom: 20px;
            padding: 13px;
            border-radius: 13px;
            background: rgba(255,255,255,.035);
            border: 1px solid var(--border);
        }

        .sidebar-footer small {
            display: block;
            color: #657083;
            font-size: 10px;
            margin-bottom: 4px;
        }

        .sidebar-footer strong {
            font-size: 12px;
        }


        /* =========================
           MAIN
        ========================= */

        .main {
            margin-left: 250px;
            padding: 34px;
            min-height: 100vh;
        }

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 28px;
        }

        .eyebrow {
            color: #5ee7c3;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            margin-bottom: 8px;
        }

        h1 {
            margin: 0;
            font-size: 31px;
            letter-spacing: -.03em;
        }

        .subtitle {
            margin-top: 7px;
            color: var(--muted);
            font-size: 13px;
        }

        .add-btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 12px 18px;
            border: 0;
            border-radius: 12px;
            background:
                linear-gradient(
                    135deg,
                    var(--green),
                    var(--green2)
                );
            color: white;
            font-size: 13px;
            font-weight: 750;
            box-shadow:
                0 10px 28px rgba(16,185,129,.18);
            transition: .2s ease;
        }

        .add-btn:hover {
            transform: translateY(-2px);
            box-shadow:
                0 14px 34px rgba(16,185,129,.25);
        }


        /* =========================
           STATS
        ========================= */

        .stats {
            display: grid;
            grid-template-columns:
                repeat(3, minmax(0,1fr));
            gap: 15px;
            margin-bottom: 20px;
        }

        .stat {
            padding: 19px;
            border-radius: 16px;
            background:
                linear-gradient(
                    145deg,
                    rgba(18,27,41,.94),
                    rgba(13,19,29,.94)
                );
            border: 1px solid var(--border);
        }

        .stat-label {
            color: #788497;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .08em;
        }

        .stat-value {
            margin-top: 9px;
            font-size: 25px;
            font-weight: 800;
        }

        .stat-value.green {
            color: #5ee7c3;
        }


        /* =========================
           TABLE CARD
        ========================= */

        .table-card {
            overflow: hidden;
            border-radius: 18px;
            background:
                linear-gradient(
                    145deg,
                    rgba(16,23,34,.96),
                    rgba(11,16,25,.96)
                );
            border: 1px solid var(--border);
            box-shadow:
                0 20px 70px rgba(0,0,0,.18);
        }

        .table-toolbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 18px 20px;
            border-bottom: 1px solid var(--border);
        }

        .table-title strong {
            display: block;
            font-size: 14px;
        }

        .table-title span {
            display: block;
            margin-top: 4px;
            color: var(--muted);
            font-size: 11px;
        }

        .search {
            width: 280px;
            max-width: 100%;
            height: 40px;
            padding: 0 13px;
            border-radius: 10px;
            outline: none;
            border: 1px solid var(--border);
            background: rgba(5,8,14,.75);
            color: white;
        }

        .search:focus {
            border-color: rgba(16,185,129,.55);
        }

        .table-wrap {
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 900px;
            border-collapse: collapse;
        }

        th,
        td {
            padding: 15px 18px;
            text-align: left;
            border-bottom: 1px solid rgba(255,255,255,.055);
        }

        th {
            color: #69768a;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .07em;
        }

        td {
            color: #e7ebf2;
            font-size: 12px;
        }

        tbody tr {
            transition: .18s ease;
        }

        tbody tr:hover {
            background: rgba(255,255,255,.025);
        }

        .user-cell {
            display: flex;
            align-items: center;
            gap: 11px;
        }

        .avatar {
            width: 35px;
            height: 35px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 10px;
            background:
                linear-gradient(
                    135deg,
                    #10b981,
                    #087f63
                );
            font-size: 12px;
            font-weight: 800;
        }

        .username {
            font-weight: 700;
        }

        .user-id {
            margin-top: 3px;
            color: #69768a;
            font-size: 10px;
        }

        .license {
            color: #b8c2d1;
            font-family: monospace;
            font-size: 11px;
        }

        .no-license {
            color: #687386;
        }

        .status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 9px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 700;
        }

        .status.active {
            color: #6ee7c5;
            background: rgba(16,185,129,.10);
            border: 1px solid rgba(16,185,129,.12);
        }

        .status.inactive {
            color: #fca5a5;
            background: rgba(239,68,68,.10);
            border: 1px solid rgba(239,68,68,.12);
        }


        /* =========================
           ACTIONS
        ========================= */

        .actions {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .action-btn {
            width: 34px;
            height: 34px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: rgba(255,255,255,.035);
            color: #b6c0ce;
            transition: .18s ease;
        }

        .action-btn:hover {
            transform: translateY(-1px);
            color: white;
            background: rgba(255,255,255,.08);
        }

        .action-btn.edit:hover {
            border-color: rgba(99,102,241,.45);
            color: #a5b4fc;
        }

        .action-btn.toggle:hover {
            border-color: rgba(16,185,129,.45);
            color: #6ee7c5;
        }

        .action-btn.delete:hover {
            border-color: rgba(239,68,68,.45);
            color: #fca5a5;
        }


        /* =========================
           EMPTY
        ========================= */

        .empty {
            padding: 60px 20px;
            text-align: center;
            color: #707c8f;
        }


        /* =========================
           MODAL
        ========================= */

        .modal {
            position: fixed;
            inset: 0;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(0,0,0,.65);
            backdrop-filter: blur(10px);
            z-index: 100;
        }

        .modal.show {
            display: flex;
        }

        .modal-card {
            width: min(560px,100%);
            max-height: 90vh;
            overflow-y: auto;
            padding: 25px;
            border-radius: 20px;
            background:
                linear-gradient(
                    145deg,
                    #141d2b,
                    #0d131e
                );
            border: 1px solid rgba(255,255,255,.10);
            box-shadow:
                0 30px 100px rgba(0,0,0,.55);
            animation: modalIn .2s ease;
        }

        @@keyframes modalIn {
            from {
                opacity: 0;
                transform: translateY(12px) scale(.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .modal-head {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 22px;
        }

        .modal-head h2 {
            margin: 0;
            font-size: 20px;
        }

        .modal-head p {
            margin: 5px 0 0;
            color: var(--muted);
            font-size: 11px;
        }

        .close-btn {
            width: 34px;
            height: 34px;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: rgba(255,255,255,.04);
            color: #aab4c3;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 15px;
        }

        .field {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .field.full {
            grid-column: 1/-1;
        }

        .field label {
            color: #aeb8c8;
            font-size: 11px;
            font-weight: 650;
        }

        .field input,
        .field select {
            width: 100%;
            height: 45px;
            padding: 0 12px;
            border-radius: 10px;
            border: 1px solid var(--border);
            outline: none;
            background: #080c13;
            color: white;
        }

        .field input:focus,
        .field select:focus {
            border-color: rgba(16,185,129,.55);
            box-shadow:
                0 0 0 3px rgba(16,185,129,.07);
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 9px;
            margin-top: 22px;
        }

        .secondary-btn,
        .primary-btn,
        .danger-btn {
            padding: 10px 15px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 700;
        }

        .secondary-btn {
            border: 1px solid var(--border);
            background: rgba(255,255,255,.04);
            color: #c1cad6;
        }

        .primary-btn {
            border: 0;
            background: linear-gradient(135deg,#10b981,#087f63);
            color: white;
        }

        .danger-btn {
            border: 0;
            background: #dc2626;
            color: white;
        }


        /* DETAILS */

        .detail-grid {
            display: grid;
            grid-template-columns: repeat(2,1fr);
            gap: 10px;
        }

        .detail {
            padding: 13px;
            border-radius: 11px;
            background: rgba(255,255,255,.035);
            border: 1px solid var(--border);
        }

        .detail span {
            display: block;
            color: #687386;
            font-size: 10px;
            margin-bottom: 5px;
        }

        .detail strong {
            font-size: 12px;
        }


        /* =========================
           TOAST
        ========================= */

        .toast {
            position: fixed;
            right: 25px;
            bottom: 25px;
            min-width: 260px;
            max-width: 380px;
            padding: 13px 16px;
            border-radius: 12px;
            background: #151e2c;
            border: 1px solid rgba(16,185,129,.22);
            color: #dffcf4;
            box-shadow: 0 18px 50px rgba(0,0,0,.35);
            transform: translateY(20px);
            opacity: 0;
            pointer-events: none;
            transition: .25s ease;
            z-index: 200;
            font-size: 12px;
        }

        .toast.show {
            transform: translateY(0);
            opacity: 1;
        }


        /* =========================
           MOBILE
        ========================= */

        @@media(max-width:900px) {

            .sidebar {
                position: relative;
                width: 100%;
                height: auto;
            }

            .sidebar-footer {
                display: none;
            }

            .main {
                margin-left: 0;
                padding: 22px;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .header {
                align-items: flex-start;
                flex-direction: column;
            }

            .add-btn {
                width: 100%;
            }

        }

        @@media(max-width:600px) {

            .main {
                padding: 15px;
            }

            h1 {
                font-size: 25px;
            }

            .table-toolbar {
                align-items: stretch;
                flex-direction: column;
            }

            .search {
                width: 100%;
            }

            .form-grid,
            .detail-grid {
                grid-template-columns: 1fr;
            }

        }

    </style>

</head>


<body>


    <!-- =========================
         SIDEBAR
    ========================== -->

    <aside class="sidebar">

        <div class="logo">
            <div class="logo-box">A</div>
            <span>Anas AI</span>
        </div>

        <nav class="nav">

            <a href="/Admin/Index">
                📊 Dashboard
            </a>

            <a class="active" href="/Admin/Users">
                👤 Users
            </a>

            <a href="/Admin/Licenses">
                🔑 Licenses
            </a>

            <a href="/Admin/Login">
                🚪 Logout
            </a>

        </nav>

        <div class="sidebar-footer">
            <small>ADMIN CONSOLE</small>
            <strong>Anas AI Management</strong>
        </div>

    </aside>


    <!-- =========================
         MAIN
    ========================== -->

    <main class="main">


        <div class="header">

            <div>

                <div class="eyebrow">
                    Administration
                </div>

                <h1>
                    Manage Users
                </h1>

                <div class="subtitle">
                    Create, edit and control Anas AI accounts.
                </div>

            </div>

            <button
                class="add-btn"
                type="button"
                onclick="openModal('addModal')">

                <span>＋</span>
                Add User

            </button>

        </div>


        <!-- =========================
             STATS
        ========================== -->

        <section class="stats">

            <div class="stat">

                <div class="stat-label">
                    Total Users
                </div>

                <div class="stat-value">
                    @Model.Users.Count
                </div>

            </div>


            <div class="stat">

                <div class="stat-label">
                    Active Users
                </div>

                <div class="stat-value green">
                    @Model.Users.Count(x => x.IsActive)
                </div>

            </div>


            <div class="stat">

                <div class="stat-label">
                    Assigned Licenses
                </div>

                <div class="stat-value">
                    @Model.Users.Count(x => x.License != null)
                </div>

            </div>

        </section>


        <!-- =========================
             USERS TABLE
        ========================== -->

        <section class="table-card">

            <div class="table-toolbar">

                <div class="table-title">

                    <strong>
                        User Accounts
                    </strong>

                    <span>
                        Manage all registered Anas AI users
                    </span>

                </div>

                <input
                    class="search"
                    id="userSearch"
                    type="search"
                    placeholder="Search users..." />

            </div>


            <div class="table-wrap">

                @if (Model.Users.Count == 0)
                {
                    <div class="empty">
                        No users found.
                    </div>
                }
                else
                {

                    <table id="usersTable">

                        <thead>

                            <tr>

                                <th>ID</th>
                                <th>User</th>
                                <th>License</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Actions</th>

                            </tr>

                        </thead>


                        <tbody>

                        @foreach (var user in Model.Users)
                        {

                            <tr
                                data-user-row
                                data-search="@user.Username @user.Id @(user.License?.LicenseKey ?? "")">

                                <td>
                                    #@user.Id
                                </td>


                                <td>

                                    <div class="user-cell">

                                        <div class="avatar">
                                            @user.Username.Substring(
                                                0,
                                                1
                                            ).ToUpper()
                                        </div>

                                        <div>

                                            <div class="username">
                                                @user.Username
                                            </div>

                                            <div class="user-id">
                                                User ID: @user.Id
                                            </div>

                                        </div>

                                    </div>

                                </td>


                                <td>

                                    @if (user.License != null)
                                    {
                                        <span class="license">
                                            @user.License.LicenseKey
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="no-license">
                                            No License
                                        </span>
                                    }

                                </td>


                                <td>

                                    @if (user.IsActive)
                                    {
                                        <span class="status active">
                                            ● Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status inactive">
                                            ● Disabled
                                        </span>
                                    }

                                </td>


                                <td>
                                    @user.CreatedAt
                                        .ToLocalTime()
                                        .ToString("dd MMM yyyy")
                                </td>


                                <td>

                                    <div class="actions">

                                        <!-- DETAILS -->

                                        <button
                                            type="button"
                                            class="action-btn"
                                            title="View details"
                                            onclick="showDetails(
                                                '@user.Id',
                                                '@user.Username',
                                                '@(user.License?.LicenseKey ?? "No License")',
                                                '@(user.License?.Plan ?? "—")',
                                                '@(user.IsActive ? "Active" : "Disabled")',
                                                '@user.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")'
                                            )">

                                            👁
                                        </button>


                                        <!-- EDIT -->

                                        <button
                                            type="button"
                                            class="action-btn edit"
                                            title="Edit user"
                                            onclick="openEdit(
                                                '@user.Id',
                                                '@user.Username',
                                                '@(user.LicenseId?.ToString() ?? "")'
                                            )">

                                            ✏️

                                        </button>


                                        <!-- TOGGLE -->

                                        <form
                                            method="post"
                                            asp-page-handler="Toggle"
                                            style="display:inline">

                                            <input
                                                type="hidden"
                                                name="id"
                                                value="@user.Id" />

                                            <button
                                                type="submit"
                                                class="action-btn toggle"
                                                title="@(user.IsActive ? "Disable user" : "Enable user")">

                                                @(user.IsActive ? "🔒" : "🔓")

                                            </button>

                                        </form>


                                        <!-- DELETE -->

                                        <form
                                            method="post"
                                            asp-page-handler="Delete"
                                            style="display:inline"
                                            onsubmit="return confirmDelete('@user.Username')">

                                            <input
                                                type="hidden"
                                                name="id"
                                                value="@user.Id" />

                                            <button
                                                type="submit"
                                                class="action-btn delete"
                                                title="Delete user">

                                                🗑

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                        }

                        </tbody>

                    </table>

                }

            </div>

        </section>

    </main>


    <!-- =========================
         ADD USER MODAL
    ========================== -->

    <div
        class="modal"
        id="addModal"
        onclick="closeOutside(event,'addModal')">

        <div class="modal-card">

            <div class="modal-head">

                <div>

                    <h2>
                        Create New User
                    </h2>

                    <p>
                        Create an Anas AI account and assign a license.
                    </p>

                </div>

                <button
                    class="close-btn"
                    type="button"
                    onclick="closeModal('addModal')">

                    ✕

                </button>

            </div>


            <form
                method="post"
                asp-page-handler="AddUser">

                <div class="form-grid">

                    <div class="field">

                        <label>
                            Username
                        </label>

                        <input
                            asp-for="NewUsername"
                            placeholder="Enter username"
                            autocomplete="off"
                            required />

                    </div>


                    <div class="field">

                        <label>
                            Password
                        </label>

                        <input
                            asp-for="NewPassword"
                            type="password"
                            placeholder="Create password"
                            autocomplete="new-password"
                            required />

                    </div>


                    <div class="field full">

                        <label>
                            License
                        </label>

                        <select asp-for="NewLicenseId">

                            <option value="">
                                No License
                            </option>

                            @foreach (var license in Model.Licenses)
                            {
                                <option value="@license.Id">
                                    @license.Plan — @license.LicenseKey
                                </option>
                            }

                        </select>

                    </div>

                </div>


                <div class="modal-actions">

                    <button
                        type="button"
                        class="secondary-btn"
                        onclick="closeModal('addModal')">

                        Cancel

                    </button>

                    <button
                        type="submit"
                        class="primary-btn">

                        Create User

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================
         EDIT MODAL
    ========================== -->

    <div
        class="modal"
        id="editModal"
        onclick="closeOutside(event,'editModal')">

        <div class="modal-card">

            <div class="modal-head">

                <div>

                    <h2>
                        Edit User
                    </h2>

                    <p>
                        Update account information and license.
                    </p>

                </div>

                <button
                    class="close-btn"
                    type="button"
                    onclick="closeModal('editModal')">

                    ✕

                </button>

            </div>


            <form
                method="post"
                asp-page-handler="EditUser">

                <input
                    type="hidden"
                    id="editId"
                    name="id" />


                <div class="form-grid">

                    <div class="field">

                        <label>
                            Username
                        </label>

                        <input
                            id="editUsername"
                            name="username"
                            required />

                    </div>


                    <div class="field">

                        <label>
                            New Password
                        </label>

                        <input
                            name="password"
                            type="password"
                            placeholder="Leave empty to keep current" />

                    </div>


                    <div class="field full">

                        <label>
                            License
                        </label>

                        <select
                            id="editLicense"
                            name="licenseId">

                            <option value="">
                                No License
                            </option>

                            @foreach (var license in Model.Licenses)
                            {
                                <option value="@license.Id">
                                    @license.Plan — @license.LicenseKey
                                </option>
                            }

                        </select>

                    </div>

                </div>


                <div class="modal-actions">

                    <button
                        type="button"
                        class="secondary-btn"
                        onclick="closeModal('editModal')">

                        Cancel

                    </button>

                    <button
                        type="submit"
                        class="primary-btn">

                        Save Changes

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================
         DETAILS MODAL
    ========================== -->

    <div
        class="modal"
        id="detailsModal"
        onclick="closeOutside(event,'detailsModal')">

        <div class="modal-card">

            <div class="modal-head">

                <div>

                    <h2>
                        User Details
                    </h2>

                    <p>
                        Account information
                    </p>

                </div>

                <button
                    class="close-btn"
                    type="button"
                    onclick="closeModal('detailsModal')">

                    ✕

                </button>

            </div>


            <div class="detail-grid">

                <div class="detail">
                    <span>User ID</span>
                    <strong id="detailId">—</strong>
                </div>

                <div class="detail">
                    <span>Username</span>
                    <strong id="detailUsername">—</strong>
                </div>

                <div class="detail">
                    <span>License</span>
                    <strong id="detailLicense">—</strong>
                </div>

                <div class="detail">
                    <span>Plan</span>
                    <strong id="detailPlan">—</strong>
                </div>

                <div class="detail">
                    <span>Status</span>
                    <strong id="detailStatus">—</strong>
                </div>

                <div class="detail">
                    <span>Created</span>
                    <strong id="detailCreated">—</strong>
                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         TOAST
    ========================== -->

    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div
            class="toast show"
            id="serverToast">

            @Model.Message

        </div>
    }


    <script>

        function openModal(id) {

            document
                .getElementById(id)
                .classList.add("show");
        }


        function closeModal(id) {

            document
                .getElementById(id)
                .classList.remove("show");
        }


        function closeOutside(event, id) {

            if (event.target.id === id) {

                closeModal(id);
            }
        }


        function openEdit(id, username, licenseId) {

            document.getElementById("editId").value =
                id;

            document.getElementById("editUsername").value =
                username;

            document.getElementById("editLicense").value =
                licenseId;

            openModal("editModal");
        }


        function showDetails(
            id,
            username,
            license,
            plan,
            status,
            created
        ) {

            document.getElementById("detailId").textContent =
                "#" + id;

            document.getElementById("detailUsername").textContent =
                username;

            document.getElementById("detailLicense").textContent =
                license;

            document.getElementById("detailPlan").textContent =
                plan;

            document.getElementById("detailStatus").textContent =
                status;

            document.getElementById("detailCreated").textContent =
                created;

            openModal("detailsModal");
        }


        function confirmDelete(username) {

            return confirm(
                "Delete user \"" +
                username +
                "\"?\n\nThis action cannot be undone."
            );
        }


        /* =========================
           SEARCH
        ========================== */

        const search =
            document.getElementById("userSearch");

        if (search) {

            search.addEventListener(
                "input",
                function () {

                    const query =
                        this.value
                            .toLowerCase()
                            .trim();

                    document
                        .querySelectorAll("[data-user-row]")
                        .forEach(row => {

                            const text =
                                row.dataset.search
                                    .toLowerCase();

                            row.style.display =
                                text.includes(query)
                                    ? ""
                                    : "none";
                        });
                }
            );
        }


        /* =========================
           ESCAPE TO CLOSE
        ========================== */

        document.addEventListener(
            "keydown",
            event => {

                if (event.key !== "Escape")
                    return;

                document
                    .querySelectorAll(".modal.show")
                    .forEach(modal => {

                        modal.classList.remove("show");

                    });
            }
        );


        /* =========================
           TOAST
        ========================== */

        const toast =
            document.getElementById("serverToast");

        if (toast) {

            setTimeout(
                () => {

                    toast.classList.remove("show");

                },
                3500
            );
        }

    </script>

</body>
</html>